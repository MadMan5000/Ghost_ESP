#
# Ghost_ESP config for Waveshare ESP32-S3 Touch LCD 1.69
# Base: TDisplayS3-Touch with ST7789 (240x280) + CST816 touch
# Adjust pins via menuconfig as per Waveshare wiki.
#
# Note: This file serves as sdkconfig.defaults; run menuconfig to finalize.
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# LVGL display panel (user controllers)
CONFIG_LV_TFT_DISPLAY_CONTROLLER_ST7789=y
CONFIG_LV_TFT_DISPLAY_SPI=y
CONFIG_LV_TFT_DISPLAY_X_RES=240
CONFIG_LV_TFT_DISPLAY_Y_RES=280
CONFIG_LV_TFT_DISPLAY_ORIENTATION_PORTRAIT=y
CONFIG_LV_TFT_DISPLAY_MONOCHROME=n

# SPI bus defaults (update to Waveshare pinout in menuconfig)
CONFIG_LV_TFT_DISPLAY_SPI_HOST=1
CONFIG_LV_TFT_DISPLAY_SPI_MOSI_IO=11
CONFIG_LV_TFT_DISPLAY_SPI_MISO_IO=13
CONFIG_LV_TFT_DISPLAY_SPI_CLK_IO=12
CONFIG_LV_TFT_DISPLAY_SPI_CS_IO=10
CONFIG_LV_TFT_DISPLAY_SPI_DC_IO=9
CONFIG_LV_TFT_DISPLAY_SPI_RST_IO=8
CONFIG_LV_TFT_DISPLAY_SPI_BL_IO=15
CONFIG_LV_TFT_DISPLAY_SPI_SWAP_BYTES=n
CONFIG_LV_TFT_DISPLAY_SPI_CLOCK_SPEED_HZ=40000000

# Touch controller (CST816 on I2C)
CONFIG_LV_TOUCH_DRIVER_ENABLED=y
CONFIG_LV_TOUCH_DRIVER_CST816=y
CONFIG_LV_TOUCH_I2C_PORT=0
CONFIG_LV_TOUCH_I2C_SDA=6
CONFIG_LV_TOUCH_I2C_SCL=5
CONFIG_LV_TOUCH_INT=4
CONFIG_LV_TOUCH_RST=7

# PSRAM and flash typical for ESP32-S3 modules
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_FLASH_FREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# USB-CDC for easier flashing/monitor (optional)
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_UART=n

# WiFi enabled
CONFIG_WIFI_ENABLED=y

# Keep other defaults minimal; finalize in menuconfig.
